   "source": [
    "import pandas as pd\n",
    "import sqlite3\n",
    "from scipy import stats"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "ec1f0679",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Таблица 'orders' успешно загружена в базу данных!\n",
      "Таблица 'payments' успешно загружена в базу данных!\n",
      "Таблица 'reviews' успешно загружена в базу данных!\n",
      "\n",
      "--- БАЗА ДАННЫХ ИМИТИРОВАНА И ГОТОВА К РАБОТЕ! ---\n"
     ]
    }
   ],
   "source": [
    "conn = sqlite3.connect('ecommerce.db')\n",
    "\n",
    "files = {\n",
    "    'orders': 'olist_orders_dataset.csv',\n",
    "    'payments': 'olist_order_payments_dataset.csv',\n",
    "    'reviews': 'olist_order_reviews_dataset.csv'\n",
    "}\n",
    "\n",
    "for table_name, file_path in files.items():\n",
    "    df = pd.read_csv(file_path)\n",
    "    df.to_sql(table_name, conn, if_exists='replace', index=False)\n",
    "    print(f\"Таблица '{table_name}' успешно загружена в базу данных!\")\n",
    "\n",
    "conn.close()\n",
    "print(\"\\n--- БАЗА ДАННЫХ ИМИТИРОВАНА И ГОТОВА К РАБОТЕ! ---\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "ba6b7bd3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- РЕЗУЛЬТАТЫ СТАТИСТИЧЕСКОГО ТЕСТА ---\n",
      "Статистика Манна-Уитни: 709040324.5\n",
      "p-value: 3.7793087680514217e-47\n",
      "97.87\n",
      "87.525\n"
     ]
    }
   ],
   "source": [
    "# Выгрузка данных для А/Б-теста способов оплаты (Cards vs Boleto)\n",
    "# Очистка групп от выбросов и запуск критерия Манна-Уитни\n",
    "conn = sqlite3.connect('ecommerce.db')\n",
    "\n",
    "query = \"\"\"\n",
    "select payment_value as value,\n",
    "    payment_type as type\n",
    "from payments\n",
    "\"\"\"\n",
    "df_ab = pd.read_sql_query(query, conn)\n",
    "conn.close()\n",
    "\n",
    "# U-критерий Манна-Уитни\n",
    "cards = df_ab[\n",
    "    (df_ab['type']).isin(['credit_card', 'debit_card']) &\n",
    "    (df_ab['value'] <= 344.41)\n",#q3 + 1.5 * iqr верхнюю границу
    "]['value']\n",
    "\n",
    "boleto = df_ab[\n",
    "    (df_ab['type'] == 'boleto') &\n",
    "    (df_ab['value'] <= 344.41)\n",
    "]['value']\n",
    "\n",
    "stat, p_value = stats.mannwhitneyu(cards, boleto)\n",
    "print(\"--- РЕЗУЛЬТАТЫ СТАТИСТИЧЕСКОГО ТЕСТА ---\")\n",
    "print(f\"Статистика Манна-Уитни: {stat}\")\n",
    "print(f\"p-value: {p_value}\") # разница междугруппами значительна\n",
    "\n",
    "print(cards.median())\n",
    "print(boleto.median())\n",
    "# группа с картами имеен более высокую медиану"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "209c322f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--- РЕЗУЛЬТАТЫ КОРРЕЛЯЦИОННОГО АНАЛИЗА ---\n",
      "Коэффициент корреляции Спирмена: -0.23440802665099406\n",
      "p-value: 0.0\n"
     ]
    }
   ],
   "source": [
    "# Факторный анализ отзывов: расчет дней доставки и вычисление корреляции Спирмена (-0.23)\n",
    "# доказывающий, что логистика слабо влияет на звёзды\n",
    "conn = sqlite3.connect('ecommerce.db')\n",
    "\n",
    "query = \"\"\"\n",
    "select o.order_purchase_timestamp as timestamp,\n",
    "    o.order_delivered_customer_date as del_date,\n",
    "    r.review_score as score\n",
    "from orders o\n",
    "    join reviews r using(order_id)\n",
    "where o.order_delivered_customer_date is not null\n",
    "\"\"\"\n",
    "df_1 = pd.read_sql_query(query, conn)\n",
    "conn.close()\n",
    "\n",
    "df_1['timestamp'] = pd.to_datetime(df_1['timestamp'])\n",
    "df_1['del_date'] = pd.to_datetime(df_1['del_date'])\n",
    "df_1['deliv_days'] = (df_1['del_date'] - df_1['timestamp']).dt.days\n",
    "\n",
    "coef, p_val = stats.spearmanr(df_1['deliv_days'], df_1['score'])\n",
    "\n",
    "print(\"--- РЕЗУЛЬТАТЫ КОРРЕЛЯЦИОННОГО АНАЛИЗА ---\")\n",
    "print(f\"Коэффициент корреляции Спирмена: {coef}\")\n",
    "print(f\"p-value: {p_val}\")"
   ]
  }
 ],
